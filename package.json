{
  "name": "@dava96/osrs-wiki-bucket-builder",
  "version": "1.0.12",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "readme.md"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,json}\"",
    "pretest": "npm run lint",
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "buckets": "npx tsx ./scripts/sync_buckets.ts",
    "prepare": "husky",
    "knip": "knip"
  },
  "description": "A strictly typed, zero-dependency TypeScript query builder for the Old School RuneScape Wiki Bucket API.",
  "keywords": [
    "osrs",
    "runescape",
    "wiki",
    "bucket",
    "query-builder",
    "typescript"
  ],
  "author": "Dava96",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dava96/osrs-wiki-bucket-builder.git"
  },
  "homepage": "https://dava96.github.io/osrs-wiki-bucket-builder",
  "bugs": {
    "url": "https://github.com/Dava96/osrs-wiki-bucket-builder/issues"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-syntax-typescript": "^7.29.7",
    "@eslint/js": "^9.39.2",
    "@jest/globals": "^30.2.0",
    "@swc/core": "^1.15.43",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.3",
    "axios": "^1.13.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "knip": "^6.25.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.json": [
      "prettier --write"
    ]
  }
}
